PORT=8421

MONGO_URI='mongodb://db_retro_dev_journey:27017'
MONGO_USERNAME='username'
MONGO_PASSWORD='really_strong_password'

# Comma-separated list of tenant ids. One backend + one MongoDB server can
# serve several frontend deployments (different domains); each tenant gets
# its own logical database, JWT secret, root user and upload folder, fully
# isolated from the others. Add or remove ids here, then fill in the
# matching <ID>_* block below (see internal/tenant/tenant.go).
TENANTS=site1,site2

SITE1_ALLOW_ORIGIN='http://localhost:3000'
SITE1_DB_NAME='retro_db_site1'
SITE1_JWT_SECRET='my_secret_jwt_site1'
SITE1_ROOT_USERNAME='root_user'
SITE1_ROOT_PASSWORD='Root_password00!'
SITE1_ROOT_EMAIL='root@email.com'
SITE1_UPLOAD_DIR='./uploads/site1'
SITE1_CV_FILENAME='cv.pdf'

SITE2_ALLOW_ORIGIN='http://localhost:3001'
SITE2_DB_NAME='retro_db_site2'
SITE2_JWT_SECRET='my_secret_jwt_site2'
SITE2_ROOT_USERNAME='root_user'
SITE2_ROOT_PASSWORD='Root_password00!'
SITE2_ROOT_EMAIL='root@email.com'
SITE2_UPLOAD_DIR='./uploads/site2'
SITE2_CV_FILENAME='cv.pdf'
