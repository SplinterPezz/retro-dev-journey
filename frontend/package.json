{
  "name": "retro-dev-journey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@uiw/react-codemirror": "^4.25.12",
    "apexcharts": "^4.7.0",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.23",
    "lucide-react": "^0.511.0",
    "react": "^19.3.0",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.3.0",
    "react-joystick-component": "^6.2.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "redux-persist": "^6.0.0"
  },
  "scripts": {
    "start:loc": "env-cmd -f .env.local vite",
    "start:dev": "env-cmd -f .env.dev vite",
    "start:stage": "env-cmd -f .env.stage vite",
    "start:prod": "env-cmd -f .env.prod vite",
    "build": "npm run typecheck && vite build",
    "build:local": "env-cmd -f .env.local npm run build",
    "build:dev": "env-cmd -f .env.dev npm run build",
    "build:stage": "env-cmd -f .env.stage npm run build",
    "build:prod": "env-cmd -f .env.prod npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "env-cmd": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
